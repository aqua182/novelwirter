# SQLite is the default. For PostgreSQL use: postgresql+psycopg://user:password@localhost/novelwriter
DATABASE_URL=sqlite:///./novelwriter.db
DEEPSEEK_API_KEY=your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
CORS_ORIGINS=http://localhost:5173
# Context safety settings for observable AI runs
CONTEXT_TOKEN_BUDGET=20000
CONTEXT_WARNING_THRESHOLD=0.7
# Fernet key used to encrypt user-owned model API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_CONFIG_ENCRYPTION_KEY=
# Keep false in production. When true, only localhost HTTP model endpoints are accepted.
ALLOW_LOCAL_MODEL_URLS=false
