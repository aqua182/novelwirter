# SQLite is the default. For PostgreSQL use: postgresql+psycopg://user:password@localhost/novelwriter
DATABASE_URL=sqlite:///./novelwriter.db
DEEPSEEK_API_KEY=your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
CORS_ORIGINS=http://localhost:5173
# Context safety settings for observable AI runs
CONTEXT_TOKEN_BUDGET=20000
CONTEXT_WARNING_THRESHOLD=0.7
